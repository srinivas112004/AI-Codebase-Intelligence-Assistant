# AI Codebase Intelligence Assistant - Environment Configuration

# Google Gemini API Configuration (Required for RAG answers and code explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./data/app.db

# Vector Database Storage Path
CHROMA_PATH=./data/chroma

# Embedding Model (Configurable Sentence Transformers model)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage Directory for Cloned & Uploaded Repositories
REPOS_STORAGE_PATH=./data/repos

# Server & CORS Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
