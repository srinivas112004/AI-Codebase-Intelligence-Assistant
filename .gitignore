# ==============================================================================
# AI Codebase Intelligence Assistant - .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Python Virtual Environments
env/
venv/
.venv/
backend/venv/
backend/.venv/
ENV/
env.bak/
venv.bak/

# Testing & Pytest Cache
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environment Variables & Secrets (CRITICAL: Do NOT remove)
.env
.env.local
.env.*.local
*.env
!*.env.example

# Local SQLite Database & Vector Store
*.db
*.sqlite3
data/*
!data/.gitkeep
!data/repos/
data/repos/*
!data/repos/.gitkeep
!data/chroma/
data/chroma/*
!data/chroma/.gitkeep

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.log
